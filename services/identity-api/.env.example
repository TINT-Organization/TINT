IDENTITY_API_PORT=8081
SYNC_CORE_URL=http://localhost:8083
SOCIAL_CORE_URL=http://localhost:8082
ANALYTICS_URL=http://localhost:8084
# stream-core: alta/baja de las salas live en POST /events/start (ADR 0019)
STREAM_CORE_URL=http://localhost:8086
# Secreto de X-Internal-Token para /api/v1/internal/rooms/* (igual que en stream-core).
# Sin él, esas rutas responden 503. Cámbialo en producción.
INTERNAL_API_SECRET=dev-internal-secret-change-in-prod
NODE_ENV=development

AUTH_PROVIDER=firebase

JWT_ISSUER=tint-identity
# Audiencia propia de identity-api (ADR 0030): REST y guest token.
JWT_AUDIENCE=tint:api
# Transición de ADR 0030: audiencia legada que se acepta además de la propia y con la que se emiten
# el guest token, el sync-ticket y el analytics-ticket. Vacía = desactivada (falla cerrado).
JWT_LEGACY_AUDIENCE=tint:room
JWT_SECRET=dev-secret-change-in-prod
GUEST_TOKEN_TTL_HOURS=4
INVITATION_DEFAULT_TTL_HOURS=24
# TTL del sync-ticket y del analytics-ticket del host (segundos)
SYNC_TICKET_TTL_SECONDS=600
# TTL de los tickets por servicio de POST /rooms/:id/tickets/:service (segundos, ADR 0030)
SERVICE_TICKET_TTL_SECONDS=600

DATABASE_URL=postgres://tint:tint@localhost:5432/tint?sslmode=disable
REDIS_URL=redis://localhost:6379

# MinIO (S3) para URLs firmadas de reproducción
MINIO_ENDPOINT=http://localhost:9000
# Host que ve el navegador en la URL firmada (opcional; por defecto MINIO_ENDPOINT)
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=tintadmin
MINIO_SECRET_KEY=tintadmin123
MINIO_BUCKET=tint-media
MINIO_REGION=us-east-1
PLAYBACK_URL_TTL_SECONDS=3600
# Subida directa navegador → MinIO (URL PUT firmada)
UPLOAD_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=2147483648

# Proyecto de Firebase (obligatorio: iss/aud de los ID tokens)
FIREBASE_PROJECT_ID=tint-login
# Solo desarrollo (ADR 0024): con valor acepta los ID tokens sin firma del Firebase Auth Emulator.
# Exige NODE_ENV distinto de production y FIREBASE_PROJECT_ID=demo-* (p. ej. demo-tint); si no, no arranca.
FIREBASE_AUTH_EMULATOR_HOST=
